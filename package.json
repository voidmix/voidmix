      "packages/*",
      "e2e"
    ],
    "catalog": {
      "@orpc/client": "2.0.0-beta.32",
      "@orpc/contract": "2.0.0-beta.32",
      "@orpc/server": "2.0.0-beta.32",
      "@better-auth/drizzle-adapter": "1.7.2",
      "better-auth": "1.7.2",
      "use-intl": "4.14.1",
      "@tanstack/react-router": "1.170.32",
      "@tanstack/react-start": "1.168.49",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "uuid": "14.0.2"
    },
    "catalogs": {
      "backend": {
        "drizzle-kit": "1.0.0-rc.5-ab785fc",
