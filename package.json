{
  "name": "voidmix",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "type": "module",
  "scripts": {
    "repo": "bun run --cwd packages/scripts repo",
    "doctor": "bun run repo doctor",
    "env:init": "bun run repo env:init",
    "services:up": "bun run repo services:up",
    "services:down": "bun run repo services:down",
    "services:status": "bun run repo services:status",
    "test:scripts": "turbo run test --filter=@voidmix/scripts --",
    "test:logger": "turbo run test --filter=@voidmix/logger --",
    "test:api": "turbo run test --filter=@voidmix/api-server --",
    "docker:init": "bun run repo docker:init",
    "docker:build": "bun run repo docker:build",
    "docker:up": "bun run repo docker:up",
    "docker:down": "bun run repo docker:down",
    "docker:status": "bun run repo docker:status",
    "docker:logs": "bun run repo docker:logs",
    "docker:smoke": "bun packages/scripts/src/deploy/smoke.ts",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@voidmix/web --filter=@voidmix/api-server",
    "dev:api": "turbo run dev --filter=@voidmix/api-server",
    "dev:desktop": "turbo run dev:native --filter=@voidmix/desktop",
    "dev:desktop:web": "turbo run dev --filter=@voidmix/desktop",
    "dev:mobile": "API_HOST=0.0.0.0 WEB_HOST=0.0.0.0 turbo run dev --filter=@voidmix/mobile --filter=@voidmix/api-server --filter=@voidmix/web",
    "dev:mobile:ios": "bun run --cwd apps/mobile ios",
    "dev:mobile:android": "bun run --cwd apps/mobile android",
    "dev:mobile:web": "bun run --cwd apps/mobile web",
    "cli": "bun run --cwd apps/cli cli",
    "preview:mobile": "bun run --cwd apps/mobile preview",
    "preview:desktop": "bun run --cwd apps/desktop preview",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@voidmix/web",
    "build:api": "turbo run build --filter=@voidmix/api-server",
    "build:desktop": "bun run --cwd apps/desktop build:native",
    "build:mobile": "turbo run build --filter=@voidmix/mobile",
    "build:cli": "turbo run build --filter=@voidmix/cli",
    "build:cli:binary": "bun run --cwd apps/cli build:binary",
    "start": "turbo run start --filter=@voidmix/web --filter=@voidmix/api-server",
    "start:web": "bun run --cwd apps/web start",
    "start:api": "bun run --cwd apps/api start",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "format:go": "cd apps/desktop && gofmt -w .",
    "check:go": "bun run --cwd apps/desktop check:go",
    "check:mobile": "bun run --cwd apps/mobile check:expo",
    "check:workspace": "bun run repo check",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:check": "bun run --cwd packages/db check",
    "db:studio": "bun run --cwd packages/db studio",
    "typecheck": "turbo run typecheck",
    "test:e2e": "EXPO_PUBLIC_API_URL=http://127.0.0.1:4312 turbo run test:e2e --filter=@voidmix/e2e --",
    "test:e2e:ui": "EXPO_PUBLIC_API_URL=http://127.0.0.1:4312 turbo run test:e2e --filter=@voidmix/e2e -- --ui",
    "test:e2e:install": "bun run --cwd tests/e2e install:browsers",
    "test:e2e:report": "bun run --cwd tests/e2e report",
    "check": "bun run lint && bun run format:check && bun run check:workspace && bun run typecheck && bun run check:go",
    "ui:add": "bun run --cwd packages/ui ui:add",
    "test:go": "bun run --cwd apps/desktop test",
    "cache:up": "docker compose up -d --wait redis",
    "cache:down": "docker compose stop redis",
    "test:cache": "turbo run test --filter=@voidmix/cache --",
    "storage:up": "docker compose up -d --wait s3 && bun run storage:init",
    "storage:down": "docker compose stop s3",
    "storage:init": "bun run --cwd packages/storage init:local",
    "test:storage": "turbo run test --filter=@voidmix/storage --"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "turbo": "^2.11.11",
    "typescript": "~6.0.2"
  },
  "resolutions": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.22.0"
  },
  "packageManager": "bun@1.4.4"
}
