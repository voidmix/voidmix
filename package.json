{
  "name": "voidmix",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "e2e"
    ],
    "catalog": {
      "@orpc/client": "2.0.0-beta.40",
      "@orpc/contract": "2.0.0-beta.40",
      "@orpc/server": "2.0.0-beta.40",
      "@earendil-works/pi-coding-agent": "0.85.1",
      "@better-auth/drizzle-adapter": "^1.7.6",
      "better-auth": "^1.7.6",
      "evlog": "^2.29.0",
      "use-intl": "^4.14.7",
      "@tanstack/react-router": "^1.170.39",
      "@tanstack/react-store": "^0.11.1",
      "@tanstack/react-start": "^1.168.58",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "zod": "^4.6.5",
      "uuid": "^14.0.2"
    },
    "catalogs": {
      "backend": {
        "drizzle-kit": "1.0.0-rc.5-5935859",
        "drizzle-orm": "1.0.0-rc.5-5935859",
        "hono": "^4.13.9",
        "ioredis": "^6.0.0",
        "nanoid": "^6.0.1",
        "nitro": "3.0.260903-beta",
        "postgres": "^3.4.9"
      },
      "frontend": {
        "@base-ui/react": "^1.8.0",
        "@phosphor-icons/react": "^2.1.10",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/cli": "^2.11.5",
        "@tauri-apps/plugin-opener": "^2.5.5",
        "class-variance-authority": "^0.7.1",
        "cn": "0.3.3",
        "react-email": "^6.11.0",
        "resend": "^6.28.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.15"
      },
      "tooling": {
        "@dotenvx/dotenvx": "^2.30.0",
        "@playwright/test": "^1.63.0",
        "@storybook/addon-a11y": "10.6.0",
        "@storybook/addon-docs": "10.6.0",
        "@storybook/react-vite": "10.6.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@vitest/coverage-v8": "4.1.11",
        "knip": "^6.38.0",
        "esbuild": "^0.28.2",
        "jsdom": "^30.1.1",
        "jiti": "^2.7.0",
        "lightningcss": "1.33.0",
        "@tanstack/router-cli": "1.167.38",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "citty": "^0.2.2",
        "oxc-transform-react": "^0.150.0",
        "storybook": "10.6.0",
        "taze": "^21.1.0",
        "typescript": "7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
        "vite-plus": "0.3.3"
      }
    }
  },
  "type": "module",
  "scripts": {
    "doctor": "vmx doctor",
    "policy": "vmx policy",
    "policy:fix": "vmx policy --fix",
    "i18n:check": "vmx i18n",
    "skills:update": "vmx skills update",
    "clean": "vmx clean",
    "clean:all": "vmx clean --dependencies",
    "clean:bun-cache": "vmx clean --bun-cache",
    "deps:check": "vmx deps check",
    "deps:update": "vmx deps update",
    "deps:dedupe": "vmx deps dedupe",
    "deps:dedupe:check": "vmx deps dedupe --check",
    "deps:audit": "vmx deps audit",
    "dev": "vp run --filter './apps/*' --filter './packages/shared' --parallel dev",
    "build": "vp run -r --cache build",
    "check": "vp run -r check",
    "lint": "vp lint",
    "knip:report": "knip --no-progress --reporter compact --no-exit-code",
    "format": "vp fmt --check",
    "format:fix": "vp fmt",
    "test": "vp run -r test",
    "test:unit": "vp run -r test:unit",
    "test:integration": "vp run -r test:integration",
    "test:component": "vp run -r test:component",
    "test:coverage": "vp run -r test:coverage",
    "test:e2e": "vp run @voidmix/e2e#e2e",
    "db:migrate": "vmx db migrate",
    "db:push": "vmx db push",
    "db:clean": "vmx db clean",
    "db:seed": "vmx db seed",
    "db:studio": "vmx db studio",
    "admin:create": "vmx admin create",
    "generate": "vmx generate",
    "desktop:build": "vmx desktop build",
    "storybook": "bun run --cwd apps/storybook dev",
    "storybook:build": "bun run --cwd apps/storybook build",
    "verify": "vmx verify",
    "shadcn:update": "vmx shadcn update",
    "postinstall": "bun run --cwd packages/shared build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:frontend",
    "@types/node": "catalog:tooling",
    "@voidmix/scripts": "workspace:*",
    "knip": "catalog:tooling",
    "tailwindcss": "catalog:frontend",
    "taze": "catalog:tooling",
    "tw-animate-css": "catalog:frontend",
    "typescript": "catalog:tooling",
    "vite-plus": "catalog:tooling"
  },
  "overrides": {
    "esbuild": "catalog:tooling",
    "jiti": "catalog:tooling",
    "lightningcss": "catalog:tooling",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.0"
}
