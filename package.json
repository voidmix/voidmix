        "hono": "4.13.5",
        "ioredis": "6.0.0",
        "nanoid": "6.0.1",
        "nitro": "3.0.260610-beta",
        "postgres": "3.4.9",
        "zod": "4.5.4"
      },
      "observability": {
        "evlog": "2.27.1"
      },
      "desktop": {
        "@tauri-apps/api": "2.11.1",
        "@tauri-apps/cli": "2.11.4",
        "@tauri-apps/plugin-opener": "2.5.4"
      },
      "frontend": {
        "@base-ui/react": "1.7.0",
        "@phosphor-icons/react": "2.1.10",
