# docker:init generates four independent secrets and preserves an existing deploy/.env.
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_SECRET_ACCESS_KEY=

# Public Web origin for browser/native authorization. Use an HTTPS domain for public deployments.
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=
CORS_ORIGINS=
LOG_LEVEL=info
LOG_FORMAT=json
# Optional OTLP/HTTP log export, for example http://collector:4318. Headers may carry credentials.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=

# Bind to loopback by default for a host reverse proxy.
WEB_BIND_HOST=127.0.0.1
WEB_PORT=3000
API_BIND_HOST=127.0.0.1
API_PORT=3002

S3_ACCESS_KEY_ID=voidmix
S3_BUCKET=voidmix
S3_REGION=us-east-1
S3_PREFIX=app

DOCKER_IMAGE_PREFIX=voidmix
IMAGE_TAG=local

# Optional HTTPS reverse proxy. Set COMPOSE_PROFILES=proxy and a DNS name that resolves to this
# host; keep the Web binding on loopback and set BETTER_AUTH_URL to https://<PROXY_WEB_DOMAIN>.
COMPOSE_PROFILES=
PROXY_WEB_DOMAIN=

# Host directory for `bun run docker:backup` PostgreSQL dumps.
BACKUP_DIR=./deploy/backups
