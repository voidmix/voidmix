API_PORT=3002
API_HOST=127.0.0.1
# LOG_LEVEL and LOG_FORMAT come from root commands; defaults are pretty in development and JSON in production.
# Root commands pass DATABASE_URL, REDIS_URL, BETTER_AUTH_URL, and BETTER_AUTH_SECRET.
# When starting directly from this directory, supply those values here or in the process environment.
# Root commands also pass S3_ENDPOINT, S3_BUCKET, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, and S3_PREFIX.
# Development CORS defaults allow localhost:8081 and 127.0.0.1:8081.
# List allowed production browser origins, comma-separated.
# CORS_ORIGINS=https://mobile.example.com
# Authentication also requires the relevant Web origin in AUTH_TRUSTED_ORIGINS.
