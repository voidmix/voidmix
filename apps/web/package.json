{
  "name": "@voidmix/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vmx env -- vp dev --port 3000",
    "build": "bun run check && vmx env -- vp build",
    "start": "node --enable-source-maps .output/server/index.mjs",
    "preview": "vmx env -- vp preview",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "vitest run --passWithNoTests integration.test",
    "test:component": "vitest run --passWithNoTests component.test",
    "test:coverage": "vitest run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov"
  },
  "dependencies": {
    "@phosphor-icons/react": "catalog:frontend",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@voidmix/env": "workspace:*",
    "@voidmix/logger": "workspace:*",
    "@voidmix/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tanstack/router-cli": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:tooling",
    "@types/react-dom": "catalog:tooling",
    "@vitejs/plugin-react": "catalog:tooling",
    "@vitest/coverage-v8": "catalog:tooling",
    "@voidmix/tsconfig": "workspace:*",
    "nitro": "catalog:backend",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  }
}
