{
  "name": "@voidmix/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vmx env -- vp dev",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vp test --run",
    "test:unit": "vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "vp test --run --passWithNoTests integration.test",
    "test:component": "vp test --run --passWithNoTests component.test",
    "test:coverage": "vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@voidmix/ai": "workspace:*",
    "@voidmix/application": "workspace:*",
    "@voidmix/core": "workspace:*",
    "@voidmix/db": "workspace:*",
    "@voidmix/env": "workspace:*",
    "@voidmix/logger": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:tooling",
    "@voidmix/tsconfig": "workspace:*"
  }
}
