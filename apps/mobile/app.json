{
  "expo": {
    "name": "Voidmix",
    "slug": "voidmix-mobile",
    "version": "0.1.0",
    "scheme": "voidmix",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voidmix.mobile"
    },
    "android": {
      "package": "com.voidmix.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-system-ui", "expo-secure-store", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
