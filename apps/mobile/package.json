{
  "name": "@voidmix/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 8081",
    "ios": "expo run:ios --port 8081",
    "android": "expo run:android --port 8081",
    "web": "expo start --web --port 8081",
    "preview": "expo serve --port ${MOBILE_PORT:-8081}",
    "build": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "check:expo": "expo install --check && expo-doctor"
  },
  "dependencies": {
    "@voidmix/api": "workspace:*",
    "@voidmix/auth": "workspace:*",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@voidmix/typescript-config": "workspace:*",
    "expo-doctor": "^1.21.8",
    "typescript": "~6.0.3"
  }
}
