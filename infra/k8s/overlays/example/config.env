# Non-secret API settings; see docs/configuration.md. Public Web origin, without /api/auth.
BETTER_AUTH_URL=https://app.example.com
AUTH_TRUSTED_ORIGINS=
CORS_ORIGINS=
LOG_LEVEL=info
LOG_FORMAT=json
# Optional OTLP/HTTP log export; put credential-bearing OTEL_EXPORTER_OTLP_HEADERS in secrets.env.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Object storage is enabled when S3_BUCKET is set; the bucket must already exist.
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=voidmix
S3_REGION=us-east-1
S3_PREFIX=app
