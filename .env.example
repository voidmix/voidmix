# Runtime
NODE_ENV=development
PORT=3002
CI=false

# API
ALLOWED_ORIGINS=http://localhost:3000
AUTH_SECRET=voidmix-development-secret-change-me
AUTH_URL=http://localhost:3002
AUTH_DOMAIN=

# Database
DATABASE_URL=postgres://voidmix:voidmix@localhost:5432/voidmix

# Repository scripts
SEED_ADMIN_EMAIL=owner@voidmix.local
SEED_ADMIN_NAME=Local Owner
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=

# Client build-time values
VITE_API_URL=http://localhost:3002

# Auth mail (server-only; logger fallback in development/test)
RESEND_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Voidmix
EMAIL_TEMPLATES_BASE_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
VITE_LOG_LEVEL=debug
VITE_LOG_PRETTY=true
