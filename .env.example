# Local PostgreSQL, matching compose.yaml development defaults.
DATABASE_URL=postgresql://voidmix:voidmix@127.0.0.1:5432/voidmix
# Log level: trace / debug / info / warn / error / fatal.
LOG_LEVEL=info
# Development defaults to pretty; production/test to JSON. Override with LOG_FORMAT=json.
# API cache; empty disables it. Use an authenticated TLS Redis URL in production.
REDIS_URL=redis://127.0.0.1:6379/0
# Cache tests use a dedicated service/database and clean only their own keys.
# TEST_REDIS_URL=redis://127.0.0.1:6379/1
# Local S3-compatible service. Inject production S3 settings at runtime; empty S3_BUCKET disables it.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=voidmix
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=voidmix
S3_SECRET_ACCESS_KEY=voidmix-local-storage
S3_PREFIX=app
# Test S3 settings are documented in packages/storage/README.md; runtime settings are never a fallback.
# Public Web origin hosting /authorize; use a reachable LAN address for physical devices.
# Web proxies same-origin /api/auth/* requests to the independent API.
BETTER_AUTH_URL=http://localhost:3000
# Generate with openssl rand -base64 32; never commit real secrets.
BETTER_AUTH_SECRET=
# Additional trusted authentication origins, comma-separated.
# AUTH_TRUSTED_ORIGINS=https://mobile.example.com
# E2E requires a separate test database.
# E2E_DATABASE_URL=postgresql://voidmix:voidmix@127.0.0.1:5432/voidmix_e2e
