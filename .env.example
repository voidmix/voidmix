# Runtime
NODE_ENV=development
PORT=3002
CI=false

# API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
VOIDMIX_ACTOR_ID=owner-local
VOIDMIX_ACTOR_ROLE=owner

# Database
DATABASE_URL=postgres://voidmix:voidmix@localhost:5432/voidmix

# Repository scripts
SEED_ADMIN_EMAIL=owner@voidmix.local
SEED_ADMIN_NAME=Local Owner
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=

# Client build-time values
VITE_API_URL=http://localhost:3002
VITE_ACTOR_ID=owner-local
VITE_ACTOR_ROLE=owner

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
VITE_LOG_LEVEL=debug
VITE_LOG_PRETTY=true
