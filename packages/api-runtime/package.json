{
  "name": "@voidmix/api-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --passWithNoTests --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "vitest run --passWithNoTests integration.test",
    "test:component": "vitest run --passWithNoTests component.test",
    "test:coverage": "vitest run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@orpc/server": "catalog:",
    "@voidmix/auth": "workspace:*",
    "@voidmix/contracts": "workspace:*",
    "@voidmix/db": "workspace:*",
    "@voidmix/domain": "workspace:*",
    "@voidmix/env": "workspace:*",
    "@voidmix/logger": "workspace:*",
    "@voidmix/mail": "workspace:*",
    "better-auth": "catalog:",
    "hono": "catalog:backend"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:tooling",
    "@voidmix/client": "workspace:*",
    "@voidmix/tsconfig": "workspace:*",
    "vitest": "catalog:tooling"
  }
}
