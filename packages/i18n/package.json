{
  "name": "@voidmix/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./build": "./src/build/index.ts",
    "./types": "./src/types-entry.ts"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --passWithNoTests --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "vitest run --passWithNoTests integration.test",
    "test:component": "vitest run --passWithNoTests component.test",
    "test:coverage": "vitest run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "i18n:generate": "bun src/cli.ts"
  },
  "dependencies": {
    "@inlang/paraglide-js": "catalog:",
    "@inlang/plugin-m-function-matcher": "catalog:",
    "@inlang/plugin-message-format": "catalog:",
    "@inlang/sdk": "catalog:",
    "citty": "catalog:tooling",
    "esbuild": "catalog:tooling",
    "urlpattern-polyfill": "catalog:frontend"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:tooling",
    "@voidmix/tsconfig": "workspace:*",
    "react": "catalog:",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "vite-plus": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
