{
  "name": "@voidmix/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./avatar": "./src/avatar.tsx",
    "./logo": "./src/logo.tsx",
    "./theme": "./src/theme/index.ts",
    "./components/ui/toast": "./src/components/ui/toast.tsx",
    "./styles.css": "./src/styles.css",
    "./styles/globals.css": "./src/styles/globals.css",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vp test --run --passWithNoTests",
    "test:unit": "vp test --run --passWithNoTests --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "vp test --run --passWithNoTests integration.test",
    "test:component": "vp test --run --passWithNoTests component.test",
    "test:coverage": "vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "catalog:frontend",
    "@phosphor-icons/react": "catalog:frontend",
    "class-variance-authority": "catalog:frontend",
    "clsx": "catalog:frontend",
    "tailwind-merge": "catalog:frontend"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:tooling",
    "@testing-library/react": "catalog:tooling",
    "@testing-library/user-event": "catalog:tooling",
    "@types/react": "catalog:tooling",
    "@vitest/coverage-v8": "catalog:tooling",
    "@voidmix/tsconfig": "workspace:*",
    "jsdom": "catalog:tooling",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  }
}
