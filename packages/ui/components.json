{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/styles/globals.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "iconLibrary": "hugeicons",
  "aliases": {
    "components": "@voidmix/ui/components",
    "utils": "@voidmix/ui/lib/utils",
    "hooks": "@voidmix/ui/hooks",
    "lib": "@voidmix/ui/lib",
    "ui": "@voidmix/ui/components"
  },
  "rtl": false,
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@affectui": {
      "url": "https://registry.collectui.pro/api/r/affectui/{name}.json",
      "headers": {
        "Authorization": "Bearer ${AFFECTUI_TOKEN}"
      }
    }
  }
}
