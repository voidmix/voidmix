{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/playwright-report/**",
    "**/test-results/**",
    "**/blob-report/**",
    "**/.expo/**",
    "**/routeTree.gen.ts",
    "**/mygo.gen.ts",
    "**/.mygo/**",
    "apps/desktop/build/**",
    "apps/cli/build/**",
    "**/dist/**",
    "**/.output/**",
    "**/.nitro/**",
    "**/.tanstack/**",
    "**/target/**",
    "bun.lock"
  ]
}
