{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["apps", "packages", "*.ts", "tests"],
  "exclude": ["**/node_modules", "**/dist", "**/.output", "**/.nitro"]
}
